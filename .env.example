# Flask signing secret. Set a unique, long random value in Vercel Production.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional managed MongoDB (for profiles, personalized settings and phrase memory).
# Leave blank to run without MongoDB; the application degrades gracefully.
MONGODB_URI=
MONGODB_DATABASE=gestureforge

# Optional MongoDB connection tuning (milliseconds / pool size).
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=750
# MONGODB_CONNECT_TIMEOUT_MS=750
# MONGODB_SOCKET_TIMEOUT_MS=1500
# MONGODB_MAX_POOL_SIZE=10

# Optional local-desktop defaults; do not set these in Vercel.
# GESTUREFORGE_PROFILE_ID=local-user
# GESTUREFORGE_SSL_CERT=certs/gestureforge-lan-cert.pem
# GESTUREFORGE_SSL_KEY=certs/gestureforge-lan-key.pem
