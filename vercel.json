{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "templates/**",
        "static/**",
        "models/sign_alphabet/**",
        "training/status/**",
        "data/custom_gestures/**"
      ]
    }
  }
}
